{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "usernames": {
      ".read": true,
      "$usernameKey": {
        ".write": "auth != null"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "publicProfiles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "listingCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "listings": {
      ".read": true,
      ".indexOn": ["category", "date", "uid"],
      "$listingId": {
        ".write": "auth != null && ( (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')) )"
      }
    },

    "buyRequests": {
      ".read": true,
      ".indexOn": ["date", "uid"],
      "$requestId": {
        ".write": "auth != null && ( (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')) )"
      }
    },

    "groupBuys": {
      ".read": true,
      ".indexOn": ["date", "uid"],
      "$groupId": {
        ".write": "auth != null && ( (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')) )",
        "participants": {
          "$participantUid": {
            ".write": "auth != null && auth.uid === $participantUid"
          }
        }
      }
    },

    "offers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["sellerUid", "buyerUid", "date"]
    },

    "ratings": {
      ".read": true,
      "$targetUid": {
        "$raterUid": {
          ".write": "auth != null && auth.uid === $raterUid"
        }
      }
    },

    "verifiedProducers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')"
      }
    },

    "verifications": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')",
      ".indexOn": ["status", "submittedAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')"
      }
    },

    "reports": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')",
      ".indexOn": ["status", "date", "listingId"],
      "$reportId": {
        ".write": "auth != null && ( (!data.exists() && newData.child('reporterUid').val() === auth.uid) || (data.exists() && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')) )"
      }
    },

    "disputes": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')",
      ".indexOn": ["status", "date"],
      "$disputeId": {
        ".write": "auth != null && ( (!data.exists() && newData.child('reporterUid').val() === auth.uid) || (data.exists() && (root.child('admins').child(auth.uid).exists() || auth.token.email === 'orontesdestek@gmail.com')) )"
      }
    }
  }
}
